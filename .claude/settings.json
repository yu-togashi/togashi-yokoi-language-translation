{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(poetry run:*)",
      "Bash(poetry install:*)",
      "Bash(poetry add:*)",
      "Bash(poetry lock:*)",
      "Bash(poetry show:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(./compile_paper.sh)",
      "Bash(./compile_paper.sh:*)",
      "Bash(pdflatex:*)",
      "Bash(bibtex:*)",
      "Bash(latexmk:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD)",
      "Bash(git push -u origin:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(mkdir -p:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv * .trash/:*)",
      "Bash(mv * ./.trash/:*)",
      "Bash(mv * .trash/latex-build/:*)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/post-agent-commit.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/stop-progress-check.sh" }
        ]
      }
    ]
  }
}
